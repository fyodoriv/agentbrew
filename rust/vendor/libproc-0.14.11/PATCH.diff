+pub(crate) fn bounded_group_pids(pgrpid: u32, capacity: usize) -> io::Result<BoundedGroupPids> {
+    let buffer_size = checked_capacity(capacity)?;
+    if pgrpid == 0 || pgrpid > i32::MAX as u32 {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "invalid process group",
+        ));
