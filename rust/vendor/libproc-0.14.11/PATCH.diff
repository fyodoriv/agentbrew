+/// A bounded process-group PID result.
+#[cfg(target_os = "macos")]
+pub struct BoundedGroupPids {
+    /// PID identities returned by the group-filtered query.
+    pub pids: Vec<u32>,
+    /// False when the provided bound was filled or completeness is unknown.
+    pub complete: bool,
+}
+
+/// Query one process group without first allocating a kernel-sized count.
+///
+/// A full result does not establish completeness. Callers must retain their
+/// process-group identity and interpret the returned members separately.
+///
+/// # Errors
+///
+/// Returns an error for an invalid group or capacity, a failed query, or an
+/// empty or malformed native result. A full buffer returns an incomplete result.
+#[cfg(target_os = "macos")]
+pub fn bounded_group_pids(pgrpid: u32, capacity: usize) -> io::Result<BoundedGroupPids> {
+    crate::libproc::sys::bounded_group_pids(pgrpid, capacity)
+}
 
