#!/usr/bin/env bash
# Repo-local pre-commit hook. A global core.hooksPath (for example dotfiles git-hooks)
# delegates to hooks/pre-commit, so the checks still run when lefthook cannot install.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if command -v lefthook >/dev/null 2>&1; then exec lefthook run pre-commit; fi
if command -v gitleaks >/dev/null 2>&1; then gitleaks git --staged --no-banner --redact -l warn; fi
scripts/check-docs.sh
